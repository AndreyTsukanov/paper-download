# grab — example configuration. Copy to `.env` and fill in what you need.
#   cp .env.example .env
# EVERYTHING here is optional: with no .env at all, grab runs fully free
# (identifier lookups need no keys; ambiguous titles are surfaced, not auto-picked).
# NEVER commit your real .env — it holds secrets. See .gitignore.

# ─── Disambiguation LLM (the only place grab uses an LLM) ─────────────────────
# Provider for the single, cheap title-disambiguation / verify call.
# openai (default) or anthropic. Without a key the tool still works — it just
# surfaces ambiguous candidates instead of auto-resolving them.
GRAB_LLM_PROVIDER=openai

# Key for the selected provider (set only the one you use).
OPENAI_API_KEY=sk-...                         # https://platform.openai.com/api-keys
# ANTHROPIC_API_KEY=sk-ant-...                # https://console.anthropic.com/  (used when GRAB_LLM_PROVIDER=anthropic)

# Override the model (default: gpt-4.1-mini; for anthropic try claude-haiku-4-5-20251001).
GRAB_MODEL=gpt-4.1-mini

# Override the OpenAI endpoint (read by the OpenAI SDK; default api.openai.com).
OPENAI_BASE_URL=https://api.openai.com/v1

# ─── Proxy (scoped to the OpenAI client ONLY) ────────────────────────────────
# If set, used *only* by the OpenAI client; every academic request is forced
# proxy-less. Set whichever your network uses.
HTTPS_PROXY=http://user:pass@host:port
# ALL_PROXY=socks5://user:pass@host:port

# ─── Open-access / Unpaywall ─────────────────────────────────────────────────
# A contact email (NOT a key) for the Unpaywall OA step. cli.py already defaults
# this, but you can point it at your own address.
PAPER_SEARCH_MCP_UNPAYWALL_EMAIL=you@example.com

# ─── Sci-Hub (off by default; only used with --scihub) ───────────────────────
# Mirror override (default https://sci-hub.ru; sci-hub.se no longer resolves).
GRAB_SCIHUB_URL=https://sci-hub.ru

# ─── Optional connector API keys (all FREE; reduce rate limits / add sources) ─
# Semantic Scholar is in the default title-search path; without a key you'll see
# HTTP 429 and that source drops out (others still answer). Request a free key:
#   https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=

# Used by the OA-download fallback chain (free keys):
#   CORE:     https://core.ac.uk/services/api
#   OpenAIRE: https://graph.openaire.eu/develop/overview.html
# CORE_API_KEY=
# OPENAIRE_API_KEY=

# Not in the default path, but the vendored connectors will read it if you add
# the source via --sources:
#   DOAJ: https://doaj.org/api  (instant, free)
# DOAJ_API_KEY=
